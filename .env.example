# Copia este fichero como ".env" y rellena los valores. El ".env" NO se sube a Git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clandestino
DB_USER=clandestino_app
DB_PASSWORD=cambia-esto

# Solo para cargar el esquema y reiniciar la base de datos en desarrollo
DB_ROOT_PASSWORD=cambia-esto

# Clave con la que la API firma los JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

API_PORT=8080

# Cuenta del barbero para las pruebas. La crea gradlew crearAdmin; aquí solo se apunta
# para no perderla (el .env no se sube a Git)
ADMIN_USUARIO=barbero
ADMIN_TELEFONO=+34600111222
ADMIN_PASSWORD=cambia-esto

# Cliente de prueba. Se registra desde la app con un código de invitación del barbero
CLIENTE_PRUEBA_USUARIO=carlos_m
CLIENTE_PRUEBA_TELEFONO=+34611222333
CLIENTE_PRUEBA_PASSWORD=cambia-esto
