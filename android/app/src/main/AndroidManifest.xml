<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AplicacionClandestino"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Tema.Clandestino">

        <!-- La única pantalla que se abre desde el lanzador. Si ya hay sesión guardada,
             pregunta a la API quién es el usuario y salta a su zona. -->
        <activity
            android:name=".ui.acceso.ActividadInicioSesion"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.acceso.ActividadRegistro"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.acceso.ActividadEspera"
            android:exported="false" />
        <activity
            android:name=".ui.cliente.ActividadCliente"
            android:exported="false" />
        <activity
            android:name=".ui.admin.ActividadAdmin"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
