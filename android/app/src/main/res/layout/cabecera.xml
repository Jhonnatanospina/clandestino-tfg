<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera de todas las pestañas: la ceja pequeña, el título en Anton y, a la derecha, los
     botones que use cada pantalla. Todos empiezan escondidos; FragmentoPanel enseña los que
     hagan falta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ceja"
            style="@style/Texto.Ceja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Hola, @marta" />

        <TextView
            android:id="@+id/titulo"
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="@string/mis_citas_titulo" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_salir"
        style="@style/Boton.Icono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/cerrar_sesion"
        android:visibility="gone"
        app:icon="@drawable/ic_salir" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_refrescar"
        style="@style/Boton.Icono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/recargar"
        android:visibility="gone"
        app:icon="@drawable/ic_refrescar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_guardar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/guardar"
        android:visibility="gone" />
</LinearLayout>
