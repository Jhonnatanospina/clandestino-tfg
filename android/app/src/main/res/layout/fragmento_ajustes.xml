<?xml version="1.0" encoding="utf-8"?>
<!-- C3 · Ajustes del cliente: su cuenta, el tema y cerrar sesión. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/cabecera" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Texto.Ceja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cuenta" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- La inicial del usuario dentro de un círculo, a falta de foto. -->
                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/fondo_circulo"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/secundario"
                        android:textSize="22sp"
                        tools:text="M" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/usuario"
                            style="@style/Texto.Destacado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            tools:text="\@marta" />

                        <TextView
                            android:id="@+id/telefono"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="+34 600 111 222" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chip_estado"
                        style="@style/Texto.Chip"
                        android:visibility="invisible"
                        tools:text="Aprobado"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Texto.Ceja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/tema" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/grupo_tema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_claro"
                            style="@style/Boton.Segmento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tema_claro" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_oscuro"
                            style="@style/Boton.Segmento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tema_oscuro" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        style="@style/Texto.Nota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/tema_se_guarda" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Texto.Ceja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/sesion" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_cerrar_sesion"
                style="@style/Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/cerrar_sesion"
                app:icon="@drawable/ic_salir"
                app:iconGravity="textStart"
                app:iconTint="@color/secundario" />

            <TextView
                android:id="@+id/version"
                style="@style/Texto.Nota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:gravity="center"
                tools:text="Clandestino · versión 1.0" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
