<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de una cita en C1. El botón de cancelar solo se ve en las próximas. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fecha"
                style="@style/Texto.Destacado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.04"
                android:textSize="18sp"
                tools:text="MAR 2 FEB" />

            <TextView
                android:id="@+id/chip_estado"
                style="@style/Texto.Chip"
                tools:text="Pendiente" />
        </LinearLayout>

        <TextView
            android:id="@+id/detalle"
            style="@style/Texto.Cuerpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Pediste a las 16:00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_cancelar"
            style="@style/Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:text="@string/cancelar_solicitud"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
