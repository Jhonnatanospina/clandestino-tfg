<?xml version="1.0" encoding="utf-8"?>
<!-- Un cliente en D4. Aprobar y Bloquear solo se ven cuando tienen sentido para su estado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/separador"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/filete" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/usuario"
                style="@style/Texto.Destacado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                tools:text="\@diego" />

            <TextView
                android:id="@+id/telefono"
                style="@style/Texto.Nota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="+34 611 222 333" />

            <TextView
                android:id="@+id/chip_estado"
                style="@style/Texto.Chip"
                android:layout_marginTop="4dp"
                tools:text="Pendiente" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_aprobar"
            style="@style/Boton.Primario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/aprobar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_bloquear"
            style="@style/Boton.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/bloquear" />
    </LinearLayout>
</LinearLayout>
