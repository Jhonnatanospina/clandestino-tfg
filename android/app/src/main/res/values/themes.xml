<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material 3 con los colores de la marca. Al ser DayNight, el modo oscuro solo
         cambia los colores (values-night/colors.xml); los estilos son los mismos. -->
    <style name="Tema.Clandestino" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/acento</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/acento_suave</item>
        <item name="colorOnPrimaryContainer">@color/acento_tinta</item>
        <item name="colorSecondaryContainer">@color/acento_suave</item>
        <item name="colorOnSecondaryContainer">@color/acento_tinta</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorSurfaceContainer">@color/superficie</item>
        <item name="colorSurfaceContainerHigh">@color/superficie</item>
        <item name="colorSurfaceContainerHighest">@color/elevado</item>
        <item name="colorOnSurface">@color/tinta</item>
        <item name="colorOnSurfaceVariant">@color/secundario</item>
        <item name="colorOutline">@color/filete_fuerte</item>
        <item name="colorOutlineVariant">@color/filete</item>
        <item name="android:windowBackground">@color/fondo</item>
        <!-- Material 3 tiñe de rojo las superficies con sombra (la barra de abajo, los
             diálogos) mezclando el color primario. Los fondos ya los elegimos a mano. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowLightStatusBar">@bool/barra_clara</item>
        <!-- Desde Android 8.1 (API 27); en un 8.0 se ignora y la barra queda como esté. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/barra_clara</item>
        <item name="materialButtonStyle">@style/Boton.Primario</item>
        <item name="textInputStyle">@style/Campo</item>
        <item name="bottomNavigationStyle">@style/Navegacion</item>
    </style>

    <!-- Textos -->
    <style name="Texto.Ceja" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/secundario</item>
    </style>

    <!-- Los titulares van en Anton y en mayúsculas, como en la web de Clandestino. -->
    <style name="Texto.Titulo" parent="">
        <item name="android:fontFamily">@font/anton</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Texto.Destacado" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/tinta</item>
    </style>

    <style name="Texto.Cuerpo" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/secundario</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Texto.Nota" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/secundario</item>
    </style>

    <!-- Cada entrada de la leyenda del calendario: cuadrito de color y su nombre. -->
    <style name="Texto.Leyenda" parent="Texto.Nota">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Chip de estado (Pendiente, Confirmada...). El color lo pone el código según el estado. -->
    <style name="Texto.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/fondo_chip</item>
        <item name="android:drawableStart">@drawable/punto</item>
        <item name="android:drawablePadding">6dp</item>
    </style>

    <!-- Botones -->
    <style name="Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Con colores fijos, desactivado se veía igual que activo (el "No vino" de una cita
         futura). Los selectores de lo marcable ya traen el gris de desactivado. -->
    <style name="Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/texto_marcable</item>
        <item name="strokeColor">@color/borde_marcable</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Botón redondo con solo un icono (refrescar, salir...). -->
    <style name="Boton.Icono" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="iconTint">@color/tinta</item>
        <item name="strokeColor">@color/filete_fuerte</item>
    </style>

    <!-- Campo de texto con la etiqueta flotante y el fondo gris de los mockups. -->
    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/elevado</item>
        <item name="boxStrokeColor">@color/acento</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Desplegable compacto (la hora final de D1). Mismo fondo gris que los campos. -->
    <style name="Campo.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/elevado</item>
        <item name="boxStrokeColor">@color/acento</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="strokeColor">@color/filete</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Navegacion" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/superficie</item>
        <item name="itemIconTint">@color/navegacion</item>
        <item name="itemTextColor">@color/navegacion</item>
        <item name="activeIndicatorLabelPadding">4dp</item>
    </style>

    <!-- Casilla que se toca para cambiar un valor (hora de inicio, de fin, cupo) en D3. -->
    <style name="Boton.Celda" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <!-- OJO: el botón de Material mete 24dp a cada lado con paddingLeft/Right. Con solo
             Start/End a 0 no se quitaban y en la casilla del cupo no cabía ni el número. -->
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto_marcable</item>
        <item name="backgroundTint">@color/elevado</item>
        <item name="strokeColor">@color/filete</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Claro / Oscuro de Ajustes: el marcado se rellena de rojo, como las horas. -->
    <style name="Boton.Segmento" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/fondo_marcable</item>
        <item name="android:textColor">@color/texto_marcable</item>
        <item name="strokeColor">@color/borde_marcable</item>
    </style>

    <!-- Burbuja de hora en "Pedir cita". -->
    <style name="Hueco" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/fondo_marcable</item>
        <item name="chipStrokeColor">@color/borde_marcable</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/texto_marcable</item>
        <item name="android:textSize">17sp</item>
        <!-- OJO: el Chip fuerza la gravedad a la izquierda, así que se centra con textAlignment.
             Solo funciona con supportsRtl="true" en el manifiesto: con "false" Android lo ignora. -->
        <item name="android:textAlignment">center</item>
        <item name="chipMinHeight">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
</resources>
