          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c176" value="&lt;b&gt;hora_ocupada&lt;/b&gt; es una columna generada (VIRTUAL): vale COALESCE(hora_final, hora_pedida) si la cita está &lt;i&gt;pendiente&lt;/i&gt; o &lt;i&gt;confirmada&lt;/i&gt; y NULL en el resto.&lt;br&gt;&lt;b&gt;UK1 = uq_citas_hueco_activo&lt;/b&gt;: UNIQUE (fecha, hora_ocupada) impide dos citas activas a la misma hora; una cita cancelada libera el hueco." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=5;fontSize=13;fontFamily=Arial;fontColor=#121212;fillColor=#F2F2F4;strokeColor=#5A5A5E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="0" y="848" width="330" height="123" as="geometry" />
        </mxCell>
        <mxCell id="e177" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#5A5A5E;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;edgeStyle=none;" edge="1" parent="1" source="c176" target="c74">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c178" value="&lt;b&gt;Restricciones CHECK&lt;/b&gt;&lt;br&gt;usuarios: precio_corte &amp;gt; 0&lt;br&gt;horarios_semanales: dia_semana de 1 a 7;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;hora_inicio &amp;lt; hora_fin&lt;br&gt;excepciones_dia: «cerrado» sin horas ni cupo;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;«abierto» con horas y hora_inicio &amp;lt; hora_fin&lt;br&gt;citas: precio y propina &amp;ge; 0 (o NULL)&lt;br&gt;&lt;b&gt;Valores por defecto&lt;/b&gt;&lt;br&gt;usuarios: rol = 'cliente', estado = 'pendiente',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;precio_corte = 15,00&lt;br&gt;horarios_semanales: cupo = 2, activo = TRUE&lt;br&gt;invitaciones y citas: estado = 'pendiente'" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=5;fontSize=13;fontFamily=Arial;fontColor=#121212;fillColor=#F2F2F4;strokeColor=#5A5A5E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="356" y="449" width="346" height="201" as="geometry" />
        </mxCell>
        <mxCell id="c179" value="&lt;b&gt;Valores de los ENUM&lt;/b&gt;&lt;br&gt;usuarios.rol: admin, cliente&lt;br&gt;usuarios.estado: pendiente, aprobado, bloqueado&lt;br&gt;invitaciones.estado: pendiente, usada&lt;br&gt;excepciones_dia.tipo: cerrado, abierto&lt;br&gt;citas.estado: pendiente, confirmada, rechazada, cancelada, caducada, hecha, no_asistio" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=5;fontSize=13;fontFamily=Arial;fontColor=#121212;fillColor=#F2F2F4;strokeColor=#5A5A5E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
