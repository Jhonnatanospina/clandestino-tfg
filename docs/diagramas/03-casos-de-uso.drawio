        <mxCell id="c32" value="&lt;b&gt;Requisito común:&lt;/b&gt; los casos UC03 a UC10 exigen haber iniciado sesión (UC02), que comparten Cliente y Administrador como &lt;b&gt;Usuario registrado&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="10" y="864" width="395" height="84" as="geometry"/></mxCell>
        <mxCell id="c33" value="El código de UC01 lo genera el administrador en UC06, y el cliente no puede usar UC03 a UC05 hasta que lo aprueba en UC07." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="421" y="864" width="395" height="84" as="geometry"/></mxCell>
