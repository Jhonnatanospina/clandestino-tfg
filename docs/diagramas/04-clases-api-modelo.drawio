        <mxCell id="c90" value="Para cada día, &lt;b&gt;ServicioHorarios&lt;/b&gt; saca un &lt;b&gt;Tramo&lt;/b&gt; de la excepción de esa fecha y, si no la hay, del horario semanal. Sin ninguna de las dos, el día está cerrado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="270" y="742" width="262" height="98" as="geometry"/></mxCell>
