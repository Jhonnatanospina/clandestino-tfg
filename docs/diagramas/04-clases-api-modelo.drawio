        <mxCell id="c67" value="Las enumeraciones tienen &lt;b&gt;enBd()&lt;/b&gt; y &lt;b&gt;desdeTexto(texto)&lt;/b&gt; para pasar del ENUM en minúsculas de MySQL al valor de Java y al revés. &lt;b&gt;EstadoDia&lt;/b&gt; no se guarda, así que en su lugar tiene &lt;b&gt;enJson()&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="20" y="624" width="522" height="66" as="geometry"/></mxCell>
