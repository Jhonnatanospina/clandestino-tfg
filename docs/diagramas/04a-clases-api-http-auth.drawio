        <mxCell id="c115" value="+ montar(baseDatos, secretoJwt, reloj): Enrutador" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=4;overflow=hidden;rotatable=0;html=1;whiteSpace=nowrap;fontSize=13;fontFamily=Arial;fontColor=#121212;" vertex="1" parent="c113"><mxGeometry x="0" y="48" width="310" height="20" as="geometry"/></mxCell>
        <mxCell id="c116" value="&lt;b&gt;Aplicacion.montar()&lt;/b&gt; crea los repositorios, los servicios y las rutas y los conecta a mano, sin inyección automática. El test de punta a punta monta la API igual, pero con un reloj fijo. &lt;b&gt;Configuracion&lt;/b&gt; lee el fichero .env. &lt;b&gt;CrearAdmin&lt;/b&gt; (paquete herramientas) es un programa aparte que da de alta al barbero." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c100"><mxGeometry x="708" y="44" width="250" height="162" as="geometry"/></mxCell>
