        <mxCell id="c33" value="+ reiniciar(clave)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=4;overflow=hidden;rotatable=0;html=1;whiteSpace=nowrap;fontSize=13;fontFamily=Arial;fontColor=#121212;" vertex="1" parent="c25"><mxGeometry x="0" y="156" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;b&gt;TokenJwt&lt;/b&gt; y &lt;b&gt;LimitadorIntentos&lt;/b&gt; reciben el &lt;b&gt;Reloj&lt;/b&gt; del paquete servicio. En los tests se les pasa uno parado y se puede probar la caducidad sin esperar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c6"><mxGeometry x="708" y="214" width="250" height="98" as="geometry"/></mxCell>
        <mxCell id="c35" value="http" style="swimlane;fontStyle=1;startSize=30;horizontal=1;collapsible=0;html=1;container=1;dropTarget=0;recursiveResize=0;fillColor=#E9E9EC;swimlaneFillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=15;fontFamily=Arial;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="44" y="664" width="972" height="762" as="geometry"/></mxCell>
        <mxCell id="c36" value="El &lt;b&gt;Enrutador&lt;/b&gt; parte la ruta en trozos y busca la que encaja (404 o 405). Si la ruta no es pública, el filtro identifica al usuario y luego se comprueban su estado y su rol (401 o 403). Cualquier &lt;b&gt;ErrorNegocio&lt;/b&gt; que salte acaba en un JSON {error, mensaje}." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c35"><mxGeometry x="14" y="44" width="300" height="114" as="geometry"/></mxCell>
