        <mxCell id="c116" value="+ responde(): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=4;overflow=hidden;rotatable=0;html=1;whiteSpace=nowrap;fontSize=13;fontFamily=Arial;fontColor=#121212;" vertex="1" parent="c108"><mxGeometry x="0" y="156" width="390" height="20" as="geometry"/></mxCell>
        <mxCell id="c117" value="+ esDuplicado(e): boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=4;overflow=hidden;rotatable=0;html=1;whiteSpace=nowrap;fontSize=13;fontFamily=Arial;fontColor=#121212;" vertex="1" parent="c108"><mxGeometry x="0" y="176" width="390" height="20" as="geometry"/></mxCell>
        <mxCell id="c118" value="&lt;font style=&quot;font-size:12px&quot;&gt;«interface»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Trabajo&amp;lt;T&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;dentro de BaseDatos&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=64;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#121212;strokeColor=#5A5A5E;strokeWidth=1.5;swimlaneFillColor=#F2F2F4;fontColor=#FFFFFF;fontSize=14;fontFamily=Arial;" vertex="1" parent="c76"><mxGeometry x="454" y="411" width="290" height="88" as="geometry"/></mxCell>
        <mxCell id="c119" value="+ hacer(conexion): T" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=4;overflow=hidden;rotatable=0;html=1;whiteSpace=nowrap;fontSize=13;fontFamily=Arial;fontColor=#121212;" vertex="1" parent="c118"><mxGeometry x="0" y="64" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="c120" value="Todos los métodos de los repositorios reciben primero la &lt;i&gt;Connection&lt;/i&gt; abierta, que aquí se omite para que quepa. &lt;b&gt;cambiarEstado&lt;/b&gt; y &lt;b&gt;actualizar&lt;/b&gt; solo tocan la fila si sigue en el estado anterior, y así dos peticiones a la vez no se pisan. Si MySQL falla, &lt;b&gt;BaseDatos&lt;/b&gt; lanza &lt;b&gt;ErrorBaseDatos&lt;/b&gt; y el Enrutador responde con un 500." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c76"><mxGeometry x="764" y="411" width="290" height="200" as="geometry"/></mxCell>
        <mxCell id="c121" value="seguridad · Contrasenas y TokenJwt (detalle en 04a)" style="swimlane;fontStyle=1;startSize=30;horizontal=1;collapsible=0;html=1;container=1;dropTarget=0;recursiveResize=0;fillColor=#E9E9EC;swimlaneFillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=15;fontFamily=Arial;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1068" height="30" as="geometry"/></mxCell>
        <mxCell id="c122" value="modelo" style="swimlane;fontStyle=1;startSize=30;horizontal=1;collapsible=0;html=1;container=1;dropTarget=0;recursiveResize=0;fillColor=#E9E9EC;swimlaneFillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=15;fontFamily=Arial;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="1568" width="1068" height="82" as="geometry"/></mxCell>
        <mxCell id="c123" value="Entidades: &lt;b&gt;Usuario&lt;/b&gt;, &lt;b&gt;Invitacion&lt;/b&gt;, &lt;b&gt;Cita&lt;/b&gt;, &lt;b&gt;HorarioSemanal&lt;/b&gt; y &lt;b&gt;ExcepcionDia&lt;/b&gt;. Valores que se calculan y no se guardan: &lt;b&gt;Tramo&lt;/b&gt;, &lt;b&gt;DiaDisponible&lt;/b&gt; y &lt;b&gt;Hueco&lt;/b&gt;. Enumeraciones: &lt;b&gt;Rol&lt;/b&gt;, &lt;b&gt;EstadoUsuario&lt;/b&gt;, &lt;b&gt;EstadoInvitacion&lt;/b&gt;, &lt;b&gt;EstadoCita&lt;/b&gt;, &lt;b&gt;TipoExcepcion&lt;/b&gt; y &lt;b&gt;EstadoDia&lt;/b&gt;. Las usan todas las capas y el detalle está en el diagrama del modelo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontFamily=Arial;fontColor=#121212;spacingLeft=4;" vertex="1" parent="c122"><mxGeometry x="10" y="34" width="1048" height="44" as="geometry"/></mxCell>
        <mxCell id="e124" value="" style="html=1;rounded=0;strokeColor=#5A5A5E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#121212;labelBackgroundColor=#FFFFFF;endArrow=open;endSize=10;endFill=0;exitX=1;exitY=0.044;exitDx=0;exitDy=0;entryX=0;entryY=0.047;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
