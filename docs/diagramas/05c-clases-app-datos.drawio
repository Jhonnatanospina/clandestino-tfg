        <mxCell id="c93" value="&lt;b&gt;Usuario&lt;/b&gt;, &lt;b&gt;Cita&lt;/b&gt;, &lt;b&gt;Invitacion&lt;/b&gt;, &lt;b&gt;HorarioSemanal&lt;/b&gt; y &lt;b&gt;ExcepcionDia&lt;/b&gt; copian los campos que manda la API y se crean con &lt;b&gt;desdeJson(json)&lt;/b&gt;. &lt;b&gt;EstadoCita&lt;/b&gt; y &lt;b&gt;EstadoUsuario&lt;/b&gt; traen la etiqueta en español que se pinta en los chips. &lt;b&gt;LecturaJson&lt;/b&gt; lee los campos que pueden venir vacíos." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c80"><mxGeometry x="746" y="44" width="220" height="178" as="geometry"/></mxCell>
