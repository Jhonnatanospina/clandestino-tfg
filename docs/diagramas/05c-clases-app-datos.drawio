        <mxCell id="c79" value="&lt;b&gt;Resultado&lt;/b&gt;, &lt;b&gt;Formatos&lt;/b&gt; y &lt;b&gt;Validaciones&lt;/b&gt; también son de este paquete y se detallan en 05d." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c69"><mxGeometry x="746" y="44" width="220" height="160" as="geometry"/></mxCell>
