        <mxCell id="c70" value="El JWT se guarda cifrado con &lt;b&gt;AES-GCM&lt;/b&gt; y una clave del &lt;b&gt;Android Keystore&lt;/b&gt;, que no sale del móvil. En las preferencias solo quedan el IV y el texto cifrado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c69"><mxGeometry x="14" y="44" width="340" height="160" as="geometry"/></mxCell>
