        <mxCell id="c42" value="# accion(mensajeExito, recargar): Callback&amp;lt;T&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=7;spacingRight=4;overflow=hidden;rotatable=0;html=1;whiteSpace=nowrap;fontSize=13;fontFamily=Arial;fontColor=#121212;" vertex="1" parent="c36"><mxGeometry x="0" y="135" width="320" height="20" as="geometry"/></mxCell>
        <mxCell id="c43" value="Las acciones que no traen datos (confirmar, cancelar, guardar...) usan el Callback que devuelve &lt;b&gt;accion()&lt;/b&gt;. Mientras esperan, &lt;b&gt;operacion&lt;/b&gt; está cargando y la pantalla desactiva los botones. Al terminar deja el mensaje para el aviso y vuelve a cargar la lista, también con un 409, porque entonces alguien ha cambiado algo mientras tanto. Los siete modelos de vista que heredan de esta clase están en 05a y 05b." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c35"><mxGeometry x="380" y="44" width="526" height="159" as="geometry"/></mxCell>
