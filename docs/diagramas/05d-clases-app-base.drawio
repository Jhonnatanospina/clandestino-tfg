        <mxCell id="c11" value="Crea una sola vez &lt;b&gt;SesionAlmacen&lt;/b&gt; y &lt;b&gt;ClienteApi&lt;/b&gt;, y los modelos de vista las piden con &lt;b&gt;app()&lt;/b&gt;. Así toda la app comparte el mismo token sin usar ninguna librería de inyección de dependencias. También guarda si el tema oscuro está activado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=13;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="c2"><mxGeometry x="380" y="44" width="526" height="179" as="geometry"/></mxCell>
