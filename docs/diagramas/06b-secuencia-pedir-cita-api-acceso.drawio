        <mxCell id="c38" value="Si todo va bien, el Enrutador llama a &lt;b&gt;RutasCliente.pedirCita(intercambio, usuario)&lt;/b&gt; y sigue en 06c. Si algo falla, recoge el &lt;b&gt;ErrorNegocio&lt;/b&gt; y responde con su código HTTP y el JSON &lt;b&gt;{error, mensaje}&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#5A5A5E;strokeWidth=1.5;fontColor=#121212;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="184" y="790" width="404" height="104" as="geometry"/></mxCell>
